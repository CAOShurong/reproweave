{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caoshurong.github.io/reproweave/schemas/task.schema.json",
  "title": "ReproWeave replication task",
  "type": "object",
  "required": ["id", "title"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "depends_on": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "paper_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "state": {"enum": ["blocked", "ready", "in_progress", "done"]},
    "priority": {"enum": ["critical", "high", "medium", "low"]},
    "estimate_hours": {"type": "number", "minimum": 0, "maximum": 1000000000},
    "acceptance": {"type": "string"},
    "blocker": {"type": "string"}
  },
  "additionalProperties": true,
  "$defs": {
    "id": {"type": "string", "maxLength": 200, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
  }
}
