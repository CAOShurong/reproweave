{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caoshurong.github.io/reproweave/schemas/screening.schema.json",
  "title": "ReproWeave screening decision",
  "type": "object",
  "required": ["id", "paper_id", "state", "reason", "recorded_at"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "paper_id": {"$ref": "#/$defs/id"},
    "state": {"enum": ["discovered", "deduplicated", "screened", "included", "excluded"]},
    "reason": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string"}
  },
  "additionalProperties": true,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
  }
}
