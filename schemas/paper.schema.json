{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caoshurong.github.io/reproweave/schemas/paper.schema.json",
  "title": "ReproWeave paper",
  "type": "object",
  "required": ["id", "title", "authors", "year"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "year": {"type": "integer", "minimum": 1000, "maximum": 3000},
    "venue": {"type": "string"},
    "doi": {"type": "string"},
    "url": {"type": "string"},
    "abstract": {"type": "string"},
    "notes": {"type": "string"},
    "source_key": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
  }
}
